# Variables de Entorno del Centro de Indicadores
# Copia este archivo como .env para desarrollo local o configuración externa
# NUNCA subas archivos .env con credenciales reales a GitHub.

# Modo de la aplicación: production | development
APP_ENV=production
APP_PORT=8080

# Configuración opcional de Backend / API REST futura
API_BASE_URL=
API_TIMEOUT_MS=5000

# Parámetros de tolerancia por defecto (%)
DEFAULT_TOLERANCE_PCT=5.0
